# PostgreSQL connection string
DATABASE_URL=postgresql://reelang:reelang@localhost:5432/reelang

# Postgres credentials (used by docker-compose)
POSTGRES_USER=reelang
POSTGRES_PASSWORD=reelang
POSTGRES_DB=reelang

# Groq API key for Whisper transcription
GROQ_API_KEY=your_groq_api_key_here

# Postgres connection string used by the test suite (separate database, same instance)
TEST_DATABASE_URL=postgresql://reelang:reelang@localhost:5432/reelang_test

# Path to the Firebase service-account JSON used to verify ID tokens sent by the Android app.
# Place the downloaded service-account JSON at backend/firebase-credentials.json (gitignored).
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Alternative to FIREBASE_CREDENTIALS_PATH for platforms without a persistent filesystem (e.g. Railway):
# paste the full service-account JSON as a single-line string. Takes precedence over FIREBASE_CREDENTIALS_PATH if set.
FIREBASE_CREDENTIALS_JSON=

# Base URL the backend uses to call the reelang_ai service (e.g. /trigger/{user_id}).
# Defaults to the docker-compose service name; override on platforms like Railway with the private network URL.
REELANG_AI_INTERNAL_URL=http://reelang_ai:8001

# Shared secret required (as X-Admin-Token header) for admin-only endpoints like POST /admin/cookies.
# Use a long random string.
ADMIN_TOKEN=your_admin_token_here

# Shared secret required (as X-Internal-Token header) for the reelang_ai service to call POST /reels/import.
# Not exposed externally (reelang_ai has no published port). Use a long random string.
INTERNAL_API_TOKEN=your_internal_api_token_here

# Comma-separated list of allowed CORS origins. The Android app and reelang_ai are not
# browser clients, so this can be left empty unless a web client is added.
CORS_ALLOWED_ORIGINS=
