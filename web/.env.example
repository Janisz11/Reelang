# ── Backend ──────────────────────────────────────────────────────────────────
# Same API the Android app talks to (ApiClient.BASE_URL).
VITE_API_BASE_URL=https://reelang-production.up.railway.app/api/v1/

# ── Firebase (web app) ───────────────────────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
# The Android google-services.json cannot be reused: a Web app has its own
# appId, and the Android API key is restricted to Android clients.
# These values are public by design — they ship inside every web bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=reelang-afcb4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=reelang-afcb4
VITE_FIREBASE_STORAGE_BUCKET=reelang-afcb4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=709335998175
# Optional — only needed if you add Firebase Analytics. Auth works without it.
VITE_FIREBASE_APP_ID=

# ── Demo account ─────────────────────────────────────────────────────────────
# Powers the "Try the demo" button on the sign-in screen. Create this account
# in Firebase Auth (email/password) and seed it with a few words and reels.
# Leave blank to hide the button entirely.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
